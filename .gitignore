# ---------------------------------------------------------------------------
# Secretos y credenciales - NUNCA subir a GitHub
# ---------------------------------------------------------------------------
.env
.env.*
*.env
secrets.env
!.env.example
!.env.template

secrets/
.secrets/
*.secret
*.secrets
*.key
*.pem
*.p12
*.pfx
*.crt
*.csr
*.jks
*.keystore
client_secret*.json
service-account*.json
service_account*.json
credentials*.json
token*.json
application_default_credentials.json
adc.json

# Configuraciones locales con posibles overrides de API keys.
# `config/*.json` puede versionarse cuando es configuracion base del proyecto;
# los overrides locales/privados quedan fuera.
config/*.local.json
config/*.private.json
*.local.json
*.private.json
*secret*.json
*credentials*.json

# ---------------------------------------------------------------------------
# Datos locales, datasets grandes y material que no debe publicarse
# INVESTIGACIÓN EN CURSO: estos directorios se harán públicos al finalizar
# ---------------------------------------------------------------------------
# Dataset bilingüe completo - datos privados de investigación
data/all_datasets_en_es/

# Patrones generales para otros datos pesados
data/**/*.csv
data/**/*.tsv
data/**/*.jsonl
data/**/*.parquet
data/**/*.arrow
data/**/*.feather
data/**/*.xlsx
data/**/*.zip
data/**/*.gz
data/**/*.7z
data/**/*.tar
data/**/*.tar.gz
!data/**/README*
!data/**/*.md
!data/**/*.txt

biblio/**/*.pdf
biblio/**/*.doc
biblio/**/*.docx
!biblio/**/README*
!biblio/**/*.md
!biblio/**/*.txt

