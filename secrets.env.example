# LabelForge — Variables de entorno
# Copia este archivo a secrets.env y completa tus keys

# ---------------------------------------------------------------------------
# API Keys de los proveedores de LLM
# ---------------------------------------------------------------------------

# Google Gemini AI Studio
GEMINI_API_KEY=tu-api-key-de-gemini

# Anthropic Claude (opcional)
ANTHROPIC_API_KEY=

# OpenAI ChatGPT (opcional)
OPENAI_API_KEY=

# Google Cloud / Vertex AI (opcional)
GOOGLE_CLOUD_PROJECT=tu-project-id-gcp
VERTEX_LOCATION=us-central1
# Ruta al JSON de la service account de GCP.
# OPCIONAL: si dejas cualquier archivo service_account JSON en secrets/,
# LabelForge lo detecta automáticamente al arrancar — no necesitas configurar esta línea.
# Solo úsala si tienes varios JSON en secrets/ y quieres forzar uno concreto:
# GOOGLE_APPLICATION_CREDENTIALS=secrets/mi-service-account.json

# ---------------------------------------------------------------------------
# Hugging Face — MUY RECOMENDADO para descargar modelos GGUF
# Sin token: HuggingFace throttlea la velocidad (~200-300 KB/s)
# Con token: velocidad completa (varios MB/s) + acceso a repos privados
# Genera tu token (gratuito) en https://huggingface.co/settings/tokens
# ---------------------------------------------------------------------------
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Configuracion del servidor web
# Puerto por defecto: 7860 (libre en macOS, Windows y Linux)
#   - macOS: el puerto 5000 esta ocupado por AirPlay Receiver desde Monterey
#   - 7860 no requiere privilegios de administrador en ningun SO
# Para cambiar, descomenta y ajusta las siguientes lineas:
# ---------------------------------------------------------------------------
# LABELFORGE_HOST=127.0.0.1
# LABELFORGE_PORT=7860

# ---------------------------------------------------------------------------
# Seguridad — OBLIGATORIO si expones la app en internet
# ---------------------------------------------------------------------------
# Contraseña para HTTP Basic Auth. Sin esta variable, la app SOLO acepta
# conexiones desde localhost (127.0.0.1). Para exposición en red/internet,
# descomenta y pon una contraseña fuerte (mínimo 16 caracteres aleatorios).
# El nombre de usuario puede ser cualquier cosa (ej: "admin").
# LABELFORGE_PASSWORD=pon-aqui-una-contrasena-fuerte-y-aleatoria

# Clave secreta de Flask para cookies de sesión. Si no la configuras,
# se genera una nueva aleatoria en cada reinicio (las sesiones no persistirán
# entre reinicios). Para producción, genera con: python -c "import secrets; print(secrets.token_hex(32))"
# LABELFORGE_SECRET_KEY=genera-con-python-secrets-token-hex-32

# ---------------------------------------------------------------------------
# Flags de depuración (no son secretos, pero se documentan aquí)
# ---------------------------------------------------------------------------
# Activa métricas en tiempo real en la webapp durante el pipeline
# DATA_LABELING_WEBAPP_METRICS=1
