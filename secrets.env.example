# LabelForge — Variables de entorno
# Copia este archivo a secrets.env y completa tus keys

# ---------------------------------------------------------------------------
# API Keys de los proveedores de LLM
# ---------------------------------------------------------------------------

# Google Gemini AI Studio
GEMINI_API_KEY=tu-api-key-de-gemini

# Anthropic Claude (opcional)
ANTHROPIC_API_KEY=

# OpenAI ChatGPT (opcional)
OPENAI_API_KEY=

# Google Cloud / Vertex AI (opcional)
GOOGLE_CLOUD_PROJECT=tu-project-id-gcp
VERTEX_LOCATION=us-central1

# ---------------------------------------------------------------------------
# Configuracion del servidor web
# Puerto por defecto: 7860 (libre en macOS, Windows y Linux)
#   - macOS: el puerto 5000 esta ocupado por AirPlay Receiver desde Monterey
#   - 7860 no requiere privilegios de administrador en ningun SO
# Para cambiar, descomenta y ajusta las siguientes lineas:
# ---------------------------------------------------------------------------
# LABELFORGE_HOST=127.0.0.1
# LABELFORGE_PORT=7860
