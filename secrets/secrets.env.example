# =============================================================================
# LabelForge — secrets.env
# =============================================================================
# Este archivo NO se versiona (ver .gitignore). Es una plantilla: copia este
# archivo como secrets/secrets.env y rellena los valores.
#
# Cargado en: main_cli.py y main_webapp.py al arrancar, via python-dotenv.
# Modulo de lectura/escritura: labelforge_core/secrets_io.py
#   - read_dotenv()       lee el archivo linea a linea (soporta UTF-8-BOM)
#   - set_secret_value()  escribe/reemplaza un valor en caliente y actualiza
#                         os.environ para que el cambio sea inmediato sin reiniciar.
#
# NUNCA pongas estos valores en config/arbiters_config.json ni en el codigo.
# El campo api_key_override en arbitros es transitorio (solo en memoria) y
# no persiste en disco por diseno.
# =============================================================================


# -----------------------------------------------------------------------------
# PROVEEDORES DE LLM — API Keys
# -----------------------------------------------------------------------------
# Mapa proveedor -> variable de entorno (definido en secrets_io.py):
#
#   "gemini"        -> GEMINI_API_KEY
#   "anthropic"     -> ANTHROPIC_API_KEY
#   "openai"        -> OPENAI_API_KEY
#   "openai_compat" -> OPENAI_API_KEY   (reutiliza la misma key)
#   "ollama"        -> (sin key; servidor local)
#   "vertex_gemini" -> (sin key; usa credenciales GCP abajo)
#
# Un arbitro sin key valida simplemente falla en el preflight. El pipeline
# continua con los arbitros que si tienen credenciales.
# -----------------------------------------------------------------------------

# Google Gemini AI Studio
# Obtener en: https://aistudio.google.com/app/apikey
# Usado por el proveedor "gemini" en arbiters_config.json.
GEMINI_API_KEY=

# Anthropic Claude
# Obtener en: https://console.anthropic.com/settings/keys
# Usado por el proveedor "anthropic" en arbiters_config.json.
ANTHROPIC_API_KEY=

# OpenAI / OpenAI-compat
# Obtener en: https://platform.openai.com/api-keys
# Tambien es usado por proveedores "openai_compat" que apunten a la API de OpenAI.
# Para endpoints compatibles con OpenAI (LM Studio, Together, etc.) puedes
# dejar esta key o configurar api_key_override en el arbitro (solo en memoria).
OPENAI_API_KEY=


# -----------------------------------------------------------------------------
# GOOGLE CLOUD / VERTEX AI
# -----------------------------------------------------------------------------
# Requerido solo si usas el proveedor "vertex_gemini".
# No necesitas GEMINI_API_KEY para Vertex; usa credenciales de servicio GCP.
#
# Flujo de autenticacion (labelforge_core/secrets_io.py -> resolve_gcp_credentials):
#   1. Si GOOGLE_APPLICATION_CREDENTIALS esta seteada y el archivo existe -> se usa.
#   2. Si la ruta es relativa -> se resuelve contra BASE_DIR del proyecto.
#   3. Si no esta seteada o el archivo no existe -> se auto-detecta el primer
#      archivo *.json con "type": "service_account" dentro de secrets/.
#      (Esto significa que basta con copiar el JSON ahi; no necesitas configurar nada.)
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=tu-project-id-gcp
VERTEX_LOCATION=us-central1

# Solo necesario si tienes VARIOS JSON de service account en secrets/ y quieres
# forzar uno concreto. En caso contrario, la auto-deteccion de arriba es suficiente.
# GOOGLE_APPLICATION_CREDENTIALS=secrets/mi-service-account.json


# -----------------------------------------------------------------------------
# HUGGING FACE — Token de acceso
# -----------------------------------------------------------------------------
# MUY RECOMENDADO si vas a descargar modelos GGUF desde Hugging Face.
#
# Sin token : HuggingFace aplica throttling (~200-300 KB/s por IP anonima).
# Con token : velocidad completa (varios MB/s) + acceso a repos privados o con gate.
#
# Generar token gratuito en: https://huggingface.co/settings/tokens
#   - Tipo "Read" es suficiente para descargar modelos publicos.
#   - Tipo "Fine-grained" con permiso "repo.read" para repos privados.
#
# Usado en: labelforge_core/local_models.py -> download_model()
#   El token se pasa como cabecera Authorization: Bearer <HF_TOKEN> en las
#   peticiones HTTP de descarga. La descarga es por streaming con soporte de
#   reanudacion (Range header) y archivo temporal .part.
# -----------------------------------------------------------------------------
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# -----------------------------------------------------------------------------
# SERVIDOR WEB — Host y puerto
# -----------------------------------------------------------------------------
# Entrypoint: main_webapp.py
# Por defecto: host=127.0.0.1, puerto=7860 (solo acceso local).
#
# Notas de puerto:
#   - 7860: libre en macOS, Windows y Linux; no requiere privilegios root.
#   - 5000: EVITAR en macOS >= Monterey (ocupado por AirPlay Receiver).
#   - Para exponer en red local: cambiar host a 0.0.0.0 (ver advertencias de seguridad).
#   - Para produccion: usar un proxy inverso (nginx/caddy) en lugar de exponer Flask directo.
#
# Tambien se pueden pasar como argumentos CLI: python main_webapp.py --host X --port Y
# Los argumentos CLI tienen precedencia sobre estas variables.
# -----------------------------------------------------------------------------
# LABELFORGE_HOST=127.0.0.1
# LABELFORGE_PORT=7860


# -----------------------------------------------------------------------------
# AUTENTICACION — Modo de login
# -----------------------------------------------------------------------------
# Variable: LABELFORGE_AUTH_MODE
# Valores:
#   local    (default) Login con usuario/contrasena almacenado en secrets/auth.db
#                      (SQLite). En el primer arranque, /login crea el primer
#                      usuario de forma interactiva.
#   oauth2             Login via proveedor externo (ver seccion OAuth2 abajo).
#                      Actualmente en estado experimental; flujo principal es "local".
#
# Para deshabilitar el login completamente (SOLO desarrollo aislado, nunca produccion):
#   LABELFORGE_AUTH_DISABLED=1
#   (equivale a saltar toda la verificacion de sesion en webapp/app.py)
# -----------------------------------------------------------------------------
LABELFORGE_AUTH_MODE=local
# LABELFORGE_AUTH_DISABLED=0


# -----------------------------------------------------------------------------
# SEGURIDAD — Clave secreta de Flask
# -----------------------------------------------------------------------------
# Usada para firmar las cookies de sesion (Flask sessions).
#
# Si NO se configura:
#   - Se genera una clave aleatoria en cada arranque.
#   - Las sesiones de usuario quedan invalidadas cada vez que se reinicia la app.
#   - Aceptable para desarrollo local; inaceptable para produccion.
#
# Si SE configura:
#   - Las sesiones sobreviven reinicios del servidor.
#   - Requerido si usas multiples workers o reinicios programados.
#
# Generar una clave segura (ejecutar una vez y guardar aqui):
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# NUNCA compartas esta clave ni la subas al repositorio.
# -----------------------------------------------------------------------------
# LABELFORGE_SECRET_KEY=


# -----------------------------------------------------------------------------
# SEGURIDAD — Cookies HTTPS
# -----------------------------------------------------------------------------
# LABELFORGE_COOKIE_SECURE=1 activa el flag Secure en todas las cookies de sesion.
# Esto hace que el navegador SOLO envie las cookies por conexiones HTTPS.
#
# Activar SIEMPRE que sirvas la app fuera de localhost (produccion, staging, etc.).
# En localhost deja el valor en 0 (HTTPS no disponible en desarrollo tipico).
#
# Flags aplicados a las cookies (webapp/app.py):
#   HttpOnly=True   -> inaccesible desde JavaScript (protege contra XSS)
#   SameSite=Lax    -> protege contra CSRF en navegacion normal
#   Secure=<este valor>
# -----------------------------------------------------------------------------
LABELFORGE_COOKIE_SECURE=0


# -----------------------------------------------------------------------------
# METRICAS EN TIEMPO REAL (flag de debug/desarrollo)
# -----------------------------------------------------------------------------
# Activa el envio de eventos SSE de metricas desde el pipeline hacia la webapp
# mientras se ejecuta el etiquetado. Util para depurar el flujo de datos entre
# labelforge_core/label_persuasion.py y webapp/app.py.
#
# No es un secreto, pero se documenta aqui porque afecta el comportamiento
# del servidor y normalmente se activa/desactiva junto con otras flags de dev.
# -----------------------------------------------------------------------------
# DATA_LABELING_WEBAPP_METRICS=1


# -----------------------------------------------------------------------------
# AUTENTICACION OAuth2/OIDC — Configuracion de aplicaciones (EXPERIMENTAL)
# -----------------------------------------------------------------------------
# Solo relevante si LABELFORGE_AUTH_MODE=oauth2.
# Estas son las credenciales de la APLICACION registrada en cada proveedor,
# NO las credenciales del usuario final (esas se introducen en la pagina del proveedor).
#
# Flujo general:
#   1. Registras LabelForge como app en el panel del proveedor.
#   2. El proveedor te da un Client ID y un Client Secret.
#   3. Configuras la URL de callback exacta en el panel del proveedor.
#   4. Pones Client ID y Secret aqui.
#
# URLs de callback segun entorno:
#   Desarrollo : http://127.0.0.1:7860/oauth/callback/<proveedor>
#   Produccion : https://TU-DOMINIO/oauth/callback/<proveedor>
#
# Proveedores habilitados (lista separada por comas):
# LABELFORGE_OAUTH_PROVIDERS=google,facebook,github,microsoft,apple

# -- Google --
# Panel: https://console.cloud.google.com/apis/credentials
# Callback: https://TU-DOMINIO/oauth/callback/google
# LABELFORGE_OAUTH_GOOGLE_CLIENT_ID=
# LABELFORGE_OAUTH_GOOGLE_CLIENT_SECRET=

# -- Facebook --
# Panel: https://developers.facebook.com/apps/
# Callback: https://TU-DOMINIO/oauth/callback/facebook
# LABELFORGE_OAUTH_FACEBOOK_CLIENT_ID=
# LABELFORGE_OAUTH_FACEBOOK_CLIENT_SECRET=

# -- GitHub --
# Panel: https://github.com/settings/applications/new
# Callback: https://TU-DOMINIO/oauth/callback/github
# LABELFORGE_OAUTH_GITHUB_CLIENT_ID=
# LABELFORGE_OAUTH_GITHUB_CLIENT_SECRET=

# -- Microsoft / Azure AD --
# Panel: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
# Callback: https://TU-DOMINIO/oauth/callback/microsoft
# LABELFORGE_OAUTH_MICROSOFT_CLIENT_ID=
# LABELFORGE_OAUTH_MICROSOFT_CLIENT_SECRET=
# LABELFORGE_OAUTH_MICROSOFT_TENANT=common
#   Valores de tenant: "common" (cuentas personales + org), "organizations" (solo org),
#                      "consumers" (solo personal), o un tenant ID especifico.

# -- Apple --
# Panel: https://developer.apple.com/account/resources/identifiers/list/serviceId
# Callback: https://TU-DOMINIO/oauth/callback/apple
# LABELFORGE_OAUTH_APPLE_CLIENT_ID=
# LABELFORGE_OAUTH_APPLE_CLIENT_SECRET=
#   Nota: Apple requiere un JWT firmado como client_secret, no una cadena simple.

# -- Control de acceso OAuth2 --
# Lista blanca de emails individuales permitidos (separados por comas):
# LABELFORGE_OAUTH_ALLOWED_EMAILS=investigador@universidad.edu,otro@dominio.com
#
# Lista blanca de dominios completos (todos los usuarios de ese dominio pueden entrar):
# LABELFORGE_OAUTH_ALLOWED_DOMAINS=universidad.edu,instituo.mx
#
# Permitir cualquier cuenta autenticada por el proveedor (SOLO para entornos cerrados
# donde el propio proveedor ya restringe quienes pueden autenticarse):
# LABELFORGE_OAUTH_ALLOW_ANY=0
# -----------------------------------------------------------------------------
